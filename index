              <label class="block text-slate-600 mb-1 font-medium">일평균 UV (명)</label>
              <input type="number" step="any" id="inputUV" required class="w-full px-2.5 py-1.5 border border-slate-300 rounded-md focus:ring-brand-500">
            </div>
            <div>
              <label class="block text-slate-600 mb-1 font-medium">일평균 PV (건)</label>
              <input type="number" step="any" id="inputPV" required class="w-full px-2.5 py-1.5 border border-slate-300 rounded-md focus:ring-brand-500">
