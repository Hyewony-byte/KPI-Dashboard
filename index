              <label class="block text-slate-600 mb-1 font-medium">전체 검색수 (실패포함)</label>
              <input type="number" step="any" id="inputSearchTotal" required class="w-full px-2.5 py-1.5 border border-slate-300 rounded-md focus:ring-brand-500">
