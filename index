<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>제타 주요지표 큐레이션 주간 리뷰 대시보드</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Pretendard Font -->
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.8/dist/web/static/pretendard.css" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Pretendard', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'Roboto', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              900: '#1e3a8a',
            },
            status: {
              up: '#dc2626',      // Korean market standard: red for increase / positive in sales
              down: '#2563eb',    // blue for decrease
              good: '#16a34a',    // green for quality improvement (e.g. error rate drop)
              warn: '#ea580c'
            }
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Pretendard', sans-serif; }
    /* Custom scrollbar for data tables */
    ::-webkit-scrollbar { height: 6px; width: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; }
      .print-shadow-none { box-shadow: none !important; }
    }
  </style>
</head>
<body class="bg-[#f8fafc] text-slate-800 antialiased min-h-screen flex flex-col">

  <!-- TOP HEADER / NAV -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-brand-500/20">
          <i class="fa-solid fa-chart-line text-lg"></i>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-xl font-bold text-slate-900 tracking-tight">제타 주요지표 주간 리뷰</h1>
            <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">운영 KPI</span>
          </div>
          <p class="text-xs text-slate-500">ZETTA Executive Weekly Performance Analytics</p>
        </div>
      </div>

      <!-- Action Tools -->
      <div class="flex items-center flex-wrap gap-2 text-sm no-print">
        <!-- Target Week Selector -->
        <div class="flex items-center bg-slate-100 rounded-lg p-1 border border-slate-200">
          <span class="text-xs font-medium text-slate-500 px-2">리뷰 주차:</span>
          <select id="weekSelector" onchange="onSelectWeek(this.value)" class="bg-white text-xs font-semibold text-slate-800 py-1 px-2.5 rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 shadow-sm cursor-pointer">
            <!-- Populated via JS -->
          </select>
        </div>

        <button onclick="openDataModal()" class="inline-flex items-center px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white font-medium text-xs rounded-lg shadow-sm transition-all">
          <i class="fa-solid fa-plus-circle mr-1.5"></i> 주간 데이터 추가/관리
        </button>
        <button onclick="window.print()" class="inline-flex items-center px-3 py-1.5 bg-white hover:bg-slate-50 text-slate-700 font-medium text-xs rounded-lg border border-slate-300 shadow-sm transition-all">
          <i class="fa-solid fa-print mr-1.5 text-slate-400"></i> 인쇄
        </button>
        <button onclick="exportToCSV()" class="inline-flex items-center px-3 py-1.5 bg-white hover:bg-slate-50 text-slate-700 font-medium text-xs rounded-lg border border-slate-300 shadow-sm transition-all">
          <i class="fa-solid fa-download mr-1.5 text-slate-400"></i> CSV
        </button>
      </div>
    </div>

    <!-- TABS -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-slate-100 no-print">
      <nav class="flex space-x-6 text-sm font-medium">
        <button onclick="switchTab('summary')" id="tab-summary" class="tab-btn py-3 border-b-2 border-brand-600 text-brand-600 flex items-center space-x-1.5">
          <i class="fa-solid fa-table-columns text-xs"></i><span>요약 대시보드</span>
        </button>
        <button onclick="switchTab('trends')" id="tab-trends" class="tab-btn py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-1.5">
          <i class="fa-solid fa-chart-area text-xs"></i><span>트렌드 심층 분석</span>
        </button>
        <button onclick="switchTab('table')" id="tab-table" class="tab-btn py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-1.5">
          <i class="fa-solid fa-table-list text-xs"></i><span>전체 지표 비교표</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full space-y-6">

    <!-- EXECUTIVE VERBAL BRIEFING BANNER -->
    <section class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div class="space-y-1.5 flex-1">
          <div class="flex items-center space-x-2">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200/60 uppercase tracking-wider">
              <i class="fa-solid fa-wand-magic-sparkles mr-1 text-indigo-500"></i> Executive Script
            </span>
            <span id="briefingDateBadge" class="text-xs text-slate-500 font-medium">기준일: 2026-11-01</span>
          </div>
          <p id="verbalScriptText" class="text-slate-800 text-sm leading-relaxed font-normal bg-slate-50/80 p-3.5 rounded-xl border border-slate-100 select-all">
            <!-- Dynamic generated text -->
          </p>
        </div>
        <div class="shrink-0 flex flex-col gap-2 no-print">
          <button onclick="copyScript()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium rounded-lg border border-slate-200 transition-all flex items-center justify-center space-x-1.5">
            <i class="fa-regular fa-copy"></i>
            <span id="copyBtnText">구두보고 복사</span>
          </button>
        </div>
      </div>
    </section>

    <!-- TAB 1: SUMMARY DASHBOARD -->
    <div id="content-summary" class="space-y-6">

      <!-- TOP 5 KPI CARDS -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">

        <!-- Card 1: UV -->
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden flex flex-col justify-between">
          <div class="flex items-center justify-between text-slate-500 mb-1">
            <span class="text-xs font-semibold">일평균 UV</span>
            <i class="fa-regular fa-user text-slate-400 text-xs"></i>
          </div>
          <div class="my-1">
            <div class="flex items-baseline space-x-1">
              <span id="card-uv-val" class="text-2xl font-bold tracking-tight text-slate-900">-</span>
              <span class="text-xs text-slate-500 font-medium">명</span>
            </div>
            <div id="card-uv-wow" class="text-xs font-semibold mt-1 flex items-center space-x-1">
              <!-- wow text -->
            </div>
          </div>
          <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
            <span>UV당 PV</span>
            <span id="card-uv-extra" class="font-semibold text-slate-600">-</span>
          </div>
          <div class="w-full h-8 mt-1">
            <canvas id="sparkline-uv"></canvas>
          </div>
        </div>

        <!-- Card 2: PV -->
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden flex flex-col justify-between">
          <div class="flex items-center justify-between text-slate-500 mb-1">
            <span class="text-xs font-semibold">일평균 PV</span>
            <i class="fa-regular fa-file-lines text-slate-400 text-xs"></i>
          </div>
          <div class="my-1">
            <div class="flex items-baseline space-x-1">
              <span id="card-pv-val" class="text-2xl font-bold tracking-tight text-slate-900">-</span>
              <span class="text-xs text-slate-500 font-medium">건</span>
            </div>
            <div id="card-pv-wow" class="text-xs font-semibold mt-1 flex items-center space-x-1">
              <!-- wow text -->
            </div>
          </div>
          <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
            <span>전주 절대치</span>
            <span id="card-pv-extra" class="font-semibold text-slate-600">-</span>
          </div>
          <div class="w-full h-8 mt-1">
            <canvas id="sparkline-pv"></canvas>
          </div>
        </div>

        <!-- Card 3: 구매전환율 -->
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden flex flex-col justify-between">
          <div class="flex items-center justify-between text-slate-500 mb-1">
            <span class="text-xs font-semibold">구매전환율 (CVR)</span>
            <span id="badge-cvr" class="px-1.5 py-0.5 text-[10px] font-bold rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">목표 달성</span>
          </div>
          <div class="my-1">
            <div class="flex items-baseline space-x-1">
              <span id="card-cvr-val" class="text-2xl font-bold tracking-tight text-slate-900">-</span>
              <span class="text-xs text-slate-500 font-medium">%</span>
            </div>
            <div id="card-cvr-wow" class="text-xs font-semibold mt-1 flex items-center space-x-1">
              <!-- wow text -->
            </div>
          </div>
          <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
            <span>일평균 주문건</span>
            <span id="card-cvr-extra" class="font-semibold text-slate-600">-</span>
          </div>
          <div class="w-full h-8 mt-1">
            <canvas id="sparkline-cvr"></canvas>
          </div>
        </div>

        <!-- Card 4: 검색 실패율 -->
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden flex flex-col justify-between">
          <div class="flex items-center justify-between text-slate-500 mb-1">
            <span class="text-xs font-semibold">검색 실패율</span>
            <span id="badge-search" class="px-1.5 py-0.5 text-[10px] font-bold rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">개선</span>
          </div>
          <div class="my-1">
            <div class="flex items-baseline space-x-1">
              <span id="card-search-val" class="text-2xl font-bold tracking-tight text-slate-900">-</span>
              <span class="text-xs text-slate-500 font-medium">%</span>
            </div>
            <div id="card-search-wow" class="text-xs font-semibold mt-1 flex items-center space-x-1">
              <!-- wow text -->
            </div>
          </div>
          <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
            <span>총 검색수</span>
            <span id="card-search-extra" class="font-semibold text-slate-600">-</span>
          </div>
          <div class="w-full h-8 mt-1">
            <canvas id="sparkline-search"></canvas>
          </div>
        </div>

        <!-- Card 5: 주문금액 -->
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden flex flex-col justify-between">
          <div class="flex items-center justify-between text-slate-500 mb-1">
            <span class="text-xs font-semibold">전체 주문금액</span>
            <i class="fa-solid fa-won-sign text-slate-400 text-xs"></i>
          </div>
          <div class="my-1">
            <div class="flex items-baseline space-x-1">
              <span id="card-rev-val" class="text-2xl font-bold tracking-tight text-slate-900">-</span>
              <span class="text-xs text-slate-500 font-medium">억원</span>
            </div>
            <div id="card-rev-wow" class="text-xs font-semibold mt-1 flex items-center space-x-1">
              <!-- wow text -->
            </div>
          </div>
          <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
            <span>건당 구매수량</span>
            <span id="card-rev-extra" class="font-semibold text-slate-600">-</span>
          </div>
          <div class="w-full h-8 mt-1">
            <canvas id="sparkline-rev"></canvas>
          </div>
        </div>

      </section>

      <!-- RECENT 3 WEEKS COMPARISON MATRIX TABLE -->
      <section class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-bold text-slate-900">최근 주차별 지표 상세 현황</h2>
            <p class="text-xs text-slate-500 mt-0.5">최근 3주간 일평균 주요 실적 및 전주 대비(WoW) 증감률 분석</p>
          </div>
          <span class="text-xs text-slate-400"><i class="fa-solid fa-circle-info mr-1"></i>검색 지표는 동일세션 기준 집계</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-slate-50/75 border-b border-slate-200 text-slate-600 font-semibold">
                <th class="py-3 px-4 w-28">구분</th>
                <th class="py-3 px-4 w-40">주요 지표 (일평균)</th>
                <th id="th-week-1" class="py-3 px-4 text-right">10월 3주차</th>
                <th id="th-week-2" class="py-3 px-4 text-right">10월 4주차</th>
                <th id="th-week-3" class="py-3 px-4 text-right bg-blue-50/50 text-brand-700 font-bold">11월 1주차 (당주)</th>
                <th class="py-3 px-4 text-right w-36">전주 대비 (WoW)</th>
                <th class="py-3 px-4 text-center w-24">3주 추이</th>
              </tr>
            </thead>
            <tbody id="comparisonTableBody" class="divide-y divide-slate-100 text-slate-700">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>
      </section>

    </div>

    <!-- TAB 2: DEEP TREND CHARTS -->
    <div id="content-trends" class="space-y-6 hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Chart 1: Traffic Trend -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-sm font-bold text-slate-900">트래픽 및 유저 탐색도 추이</h3>
              <p class="text-xs text-slate-500">일평균 UV vs PV 및 유저당 PV 추이</p>
            </div>
            <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded">일평균</span>
          </div>
          <div class="h-64">
            <canvas id="chart-traffic"></canvas>
          </div>
        </div>

        <!-- Chart 2: Order & Revenue Trend -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-sm font-bold text-slate-900">주문건수 및 매출액 추이</h3>
              <p class="text-xs text-slate-500">일평균 주문건수 vs 일평균 전체주문금액(백만원)</p>
            </div>
            <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded">전체</span>
          </div>
          <div class="h-64">
            <canvas id="chart-sales"></canvas>
          </div>
        </div>

        <!-- Chart 3: Search Health & Failure Rate -->
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm space-y-3 lg:col-span-2">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-sm font-bold text-slate-900">검색 엔진 퍼포먼스 및 실패율</h3>
              <p class="text-xs text-slate-500">전체 검색 볼륨(건) 대비 검색 실패율(%) 및 검색구매비중</p>
            </div>
            <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded">검색 세션</span>
          </div>
          <div class="h-64">
            <canvas id="chart-search"></canvas>
          </div>
        </div>

      </div>
    </div>

    <!-- TAB 3: COMPLETE DATA MATRIX -->
    <div id="content-table" class="space-y-6 hidden">
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden p-5 space-y-4">
        <div class="flex items-center justify-between flex-wrap gap-2">
          <div>
            <h3 class="text-sm font-bold text-slate-900">전체 등록 데이터 세트</h3>
            <p class="text-xs text-slate-500">등록된 모든 주차의 원본 지표 및 계산 파생치 목록입니다.</p>
          </div>
          <div class="flex gap-2">
            <button onclick="openDataModal()" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white font-medium text-xs rounded-lg">
              <i class="fa-solid fa-plus mr-1"></i> 새 주차 등록
            </button>
            <button onclick="resetToDefaultData()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs rounded-lg">
              <i class="fa-solid fa-rotate-left mr-1"></i> 샘플 데이터 초기화
            </button>
          </div>
        </div>

        <div class="overflow-x-auto border border-slate-200 rounded-xl">
          <table class="w-full text-xs text-left">
            <thead class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200">
              <tr>
                <th class="py-2.5 px-3">주차명</th>
                <th class="py-2.5 px-3">기간</th>
                <th class="py-2.5 px-3 text-right">일평균 UV</th>
                <th class="py-2.5 px-3 text-right">일평균 PV</th>
                <th class="py-2.5 px-3 text-right">UV당 PV</th>
                <th class="py-2.5 px-3 text-right">주문건수</th>
                <th class="py-2.5 px-3 text-right">구매전환율</th>
                <th class="py-2.5 px-3 text-right">검색수</th>
                <th class="py-2.5 px-3 text-right">실패수</th>
                <th class="py-2.5 px-3 text-right">실패율</th>
                <th class="py-2.5 px-3 text-right">주문금액(백만)</th>
                <th class="py-2.5 px-3 text-right">건당수량</th>
                <th class="py-2.5 px-3 text-center">관리</th>
              </tr>
            </thead>
            <tbody id="allDataTableBody" class="divide-y divide-slate-100">
              <!-- populated -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>

  <!-- DATA MODAL (ADD / EDIT) -->
  <div id="dataModal" class="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-2xl w-full max-h-[92vh] overflow-y-auto shadow-2xl border border-slate-100 animate-in fade-in duration-150">
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h3 id="modalTitle" class="text-base font-bold text-slate-900">새 주차 지표 데이터 추가</h3>
          <p class="text-xs text-slate-500">주요 일평균 원본 지표를 입력하면 파생 지표가 자동 산출됩니다.</p>
        </div>
        <button onclick="closeDataModal()" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <form id="metricForm" onsubmit="handleFormSubmit(event)" class="p-6 space-y-4 text-xs">
        <input type="hidden" id="editIndex" value="-1">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-semibold text-slate-700 mb-1">주차 명칭 <span class="text-red-500">*</span></label>
            <input type="text" id="inputWeekName" required placeholder="예: 11월 2주차" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:outline-none">
