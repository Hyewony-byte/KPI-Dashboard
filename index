            <div>
              <label class="block text-slate-600 mb-1 font-medium">검색 실패수 (건)</label>
              <input type="number" step="any" id="inputSearchFail" required class="w-full px-2.5 py-1.5 border border-slate-300 rounded-md focus:ring-brand-500">
            </div>
            <div>
              <label class="block text-slate-600 mb-1 font-medium">검색 주문건수 (건)</label>
              <input type="number" step="any" id="inputSearchOrders" required class="w-full px-2.5 py-1.5 border border-slate-300 rounded-md focus:ring-brand-500">
            </div>
          </div>
        </div>

        <div class="p-3 bg-slate-50 rounded-xl space-y-3 border border-slate-200">
          <h4 class="font-bold text-slate-800 text-xs flex items-center">
            <i class="fa-solid fa-basket-shopping text-emerald-600 mr-1.5"></i> 3. 매출 및 바스켓 지표
          </h4>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <div>
              <label class="block text-slate-600 mb-1 font-medium">전체주문금액 (백만원)</label>
              <input type="number" step="any" id="inputTotalSales" required class="w-full px-2.5 py-1.5 border border-slate-300 rounded-md focus:ring-brand-500">
            </div>
            <div>
              <label class="block text-slate-600 mb-1 font-medium">검색주문금액 (백만원)</label>
              <input type="number" step="any" id="inputSearchSales" placeholder="선택입력" class="w-full px-2.5 py-1.5 border border-slate-300 rounded-md focus:ring-brand-500">
            </div>
            <div>
              <label class="block text-slate-600 mb-1 font-medium">건당수량 (개)</label>
              <input type="number" step="0.1" id="inputBasketCount" required class="w-full px-2.5 py-1.5 border border-slate-300 rounded-md focus:ring-brand-500">
            </div>
