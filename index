        <div class="pt-3 border-t border-slate-100 flex items-center justify-end space-x-2">
          <button type="button" onclick="closeDataModal()" class="px-4 py-2 border border-slate-300 text-slate-600 rounded-lg hover:bg-slate-50 font-medium">
            취소
          </button>
          <button type="submit" class="px-5 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg font-medium shadow-sm transition-all">
            저장 및 대시보드 반영
          </button>
