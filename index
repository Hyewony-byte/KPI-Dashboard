      </form>
    </div>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div id="toastMessage" class="fixed bottom-6 right-6 z-50 bg-slate-900 text-white text-xs px-4 py-2.5 rounded-xl shadow-lg transform transition-all duration-200 opacity-0 translate-y-2 pointer-events-none flex items-center space-x-2">
    <i class="fa-solid fa-circle-check text-emerald-400"></i>
    <span id="toastText">작업이 완료되었습니다.</span>
  </div>

  <footer class="mt-auto border-t border-slate-200 py-4 text-center text-xs text-slate-400 bg-white no-print">
    제타 큐레이션 실적 모니터링 시스템 &bull; 자동 브리핑 생성 엔진 탑재
  </footer>

  <script>
    /* ============================================================
       1. DATA STRUCTURE & INITIALIZATION
    ============================================================ */
    const DEFAULT_DATA = [
      {
        weekName: "10월 3주차",
        dateRange: "10.15(목)~10.21(수)",
        uv: 310790,
        pv: 4476976,
        orderCount: 13387,
        searchTotal: 357186,
        searchFail: 11138,
        searchOrders: 27531,
        totalSales: 649,       // 백만원
        searchSales: 216,      // 백만원
        basketCount: 11.3
      },
      {
        weekName: "10월 4주차",
        dateRange: "10.22(목)~10.28(수)",
        uv: 172199,
        pv: 3611820,
        orderCount: 12174,
        searchTotal: 342042,
        searchFail: 10890,
        searchOrders: 25826,
        totalSales: 584,       // 백만원
        searchSales: 202,      // 백만원
        basketCount: 11.5
      },
      {
        weekName: "11월 1주차",
        dateRange: "10.29(목)~11.01(일)",
        uv: 365073,
        pv: 6008275,
        orderCount: 20281,
        searchTotal: 526822,
        searchFail: 14443,
        searchOrders: 36489,
        totalSales: 1104,      // 백만원
        searchSales: 313,      // 백만원
        basketCount: 11.8
      }
    ];

    let dataset = [];
    let selectedWeekIndex = 0;
    let sparklineInstances = {};
    let trendChartInstances = {};

    // Load from LocalStorage or use Default
    function initData() {
      const stored = localStorage.getItem('zeta_weekly_metrics_data');
      if (stored) {
        try {
          dataset = JSON.parse(stored);
        } catch (e) {
          dataset = [...DEFAULT_DATA];
        }
      } else {
        dataset = [...DEFAULT_DATA];
      }
      selectedWeekIndex = dataset.length - 1; // Default to latest week
    }

    function saveData() {
      localStorage.setItem('zeta_weekly_metrics_data', JSON.stringify(dataset));
    }

    function resetToDefaultData() {
      if (confirm('샘플 데이터(10월 3주차 ~ 11월 1주차)로 초기화하시겠습니까?')) {
        dataset = JSON.parse(JSON.stringify(DEFAULT_DATA));
        saveData();
        selectedWeekIndex = dataset.length - 1;
        renderAll();
        showToast('초기 데이터로 재설정되었습니다.');
      }
    }

    /* ============================================================
       2. METRIC HELPERS & CALCULATIONS
    ============================================================ */
    function calcDerived(item) {
      const uv = Number(item.uv) || 1;
      const pv = Number(item.pv) || 0;
      const orderCount = Number(item.orderCount) || 0;
      const searchTotal = Number(item.searchTotal) || 1;
      const searchFail = Number(item.searchFail) || 0;
      const searchSales = Number(item.searchSales) || 0;
      const totalSales = Number(item.totalSales) || 1;

      return {
        uvPerPv: (pv / uv).toFixed(1),
        cvr: ((orderCount / uv) * 100).toFixed(1),
        searchFailRate: ((searchFail / searchTotal) * 100).toFixed(1),
        searchRevenueShare: ((searchSales / totalSales) * 100).toFixed(1),
        searchOrderShare: ((item.searchOrders / orderCount) * 100).toFixed(1)
      };
    }

    function formatNumber(num) {
      if (num === null || num === undefined || isNaN(num)) return '-';
      return Math.round(num).toLocaleString('ko-KR');
    }

    function formatDecimal(num, decimals = 1) {
      if (num === null || num === undefined || isNaN(num)) return '-';
      return Number(num).toFixed(decimals);
    }

    // Format Korean verbal amounts: 365,073 -> "36.5만", 6,008,275 -> "601만"
    function formatKoreanMan(num) {
      if (num >= 100000000) {
        return (num / 100000000).toFixed(1) + '억';
      }
      if (num >= 10000) {
        return (num / 10000).toFixed(1) + '만';
      }
      return num.toLocaleString();
    }

    /* ============================================================
       3. UI RENDERING ENGINES
    ============================================================ */
    function renderWeekSelector() {
      const selector = document.getElementById('weekSelector');
      selector.innerHTML = '';
      dataset.forEach((item, idx) => {
        const opt = document.createElement('option');
        opt.value = idx;
        opt.textContent = `${item.weekName} (${item.dateRange})`;
        if (idx === selectedWeekIndex) opt.selected = true;
        selector.appendChild(opt);
      });
    }

    function onSelectWeek(val) {
      selectedWeekIndex = parseInt(val, 10);
      renderAll();
    }

    function renderExecutiveBriefing(current, prev) {
      const curDerived = calcDerived(current);
      const prevDerived = prev ? calcDerived(prev) : null;

      document.getElementById('briefingDateBadge').textContent = `기준일: ${current.dateRange}`;

      if (!prev) {
        document.getElementById('verbalScriptText').innerHTML = 
          `<strong>[${current.weekName} 브리핑]</strong> 일평균 UV <strong>${formatKoreanMan(current.uv)}</strong>, PV <strong>${formatKoreanMan(current.pv)}</strong>, 구매전환율 <strong>${curDerived.cvr}%</strong>, 검색 실패율 <strong>${curDerived.searchFailRate}%</strong>를 기록했습니다. (비교 가능한 전주 데이터 없음)`;
        return;
      }

      // Calculations for WoW
      const uvDiffPct = (((current.uv - prev.uv) / prev.uv) * 100).toFixed(1);
      const pvDiffPct = (((current.pv - prev.pv) / prev.pv) * 100).toFixed(1);
      const cvrDiff = (parseFloat(curDerived.cvr) - parseFloat(prevDerived.cvr)).toFixed(1);
      const failDiff = (parseFloat(curDerived.searchFailRate) - parseFloat(prevDerived.searchFailRate)).toFixed(1);
      const salesDiffPct = (((current.totalSales - prev.totalSales) / prev.totalSales) * 100).toFixed(1);
      const basketDiff = (parseFloat(current.basketCount) - parseFloat(prev.basketCount)).toFixed(1);

      const uvIcon = uvDiffPct >= 0 ? '▲' : '▼';
      const pvIcon = pvDiffPct >= 0 ? '▲' : '▼';
      const cvrIcon = cvrDiff >= 0 ? '▲' : '▼';
      const failIcon = failDiff <= 0 ? '▼' : '▲'; // for failure rate, down is improvement
      const salesIcon = salesDiffPct >= 0 ? '▲' : '▼';

      const script = `"${current.weekName} 실적 보고드리겠습니다. 
일평균 UV <strong>${formatKoreanMan(current.uv)}</strong> (WoW ${uvIcon}${Math.abs(uvDiffPct)}%), PV <strong>${formatKoreanMan(current.pv)}</strong> (WoW ${pvIcon}${Math.abs(pvDiffPct)}%)로 대규모 트래픽이 유입되었으며, 전체 주문금액은 일평균 <strong>${(current.totalSales/100).toFixed(1)}억원</strong> (WoW ${salesIcon}${Math.abs(salesDiffPct)}%)을 달성했습니다.
탐색 측면에서 UV당 PV는 <strong>${curDerived.uvPerPv}건</strong>, 구매전환율은 <strong>${curDerived.cvr}%</strong> (WoW ${cvrIcon}${Math.abs(cvrDiff)}%p)를 기록했습니다. 
아울러 검색 실패율은 <strong>${curDerived.searchFailRate}%</strong> (WoW ${failIcon}${Math.abs(failDiff)}%p 개선)로 우수한 탐색 품질을 유지하고 있으며, 건당 구매수량은 <strong>${current.basketCount}개</strong> (WoW ▲${Math.abs(basketDiff)}개)로 지속 상승 흐름에 있습니다."`;

      document.getElementById('verbalScriptText').innerHTML = script;
    }

    function renderKpiCards(current, prev) {
      const curDerived = calcDerived(current);
      const prevDerived = prev ? calcDerived(prev) : null;

      // 1. UV
      document.getElementById('card-uv-val').textContent = formatKoreanMan(current.uv);
      document.getElementById('card-uv-extra').textContent = `${curDerived.uvPerPv}건`;
      if (prev) {
        const uvPct = (((current.uv - prev.uv) / prev.uv) * 100).toFixed(1);
        const isUp = uvPct >= 0;
        document.getElementById('card-uv-wow').innerHTML = `
          <span class="${isUp ? 'text-red-600' : 'text-blue-600'}">
            ${isUp ? '▲' : '▼'} ${Math.abs(uvPct)}%
          </span>
          <span class="text-slate-400 font-normal">전주대비</span>
        `;
      } else {
        document.getElementById('card-uv-wow').textContent = '전주 데이터 없음';
      }

      // 2. PV
      document.getElementById('card-pv-val').textContent = formatKoreanMan(current.pv);
      document.getElementById('card-pv-extra').textContent = prev ? `${formatKoreanMan(prev.pv)}` : '-';
      if (prev) {
        const pvPct = (((current.pv - prev.pv) / prev.pv) * 100).toFixed(1);
        const isUp = pvPct >= 0;
        document.getElementById('card-pv-wow').innerHTML = `
          <span class="${isUp ? 'text-red-600' : 'text-blue-600'}">
            ${isUp ? '▲' : '▼'} ${Math.abs(pvPct)}%
          </span>
          <span class="text-slate-400 font-normal">전주대비</span>
        `;
      } else {
        document.getElementById('card-pv-wow').textContent = '전주 데이터 없음';
      }

      // 3. CVR
      document.getElementById('card-cvr-val').textContent = curDerived.cvr;
      document.getElementById('card-cvr-extra').textContent = `${formatNumber(current.orderCount)}건`;
      if (prev) {
        const cvrDiff = (parseFloat(curDerived.cvr) - parseFloat(prevDerived.cvr)).toFixed(1);
        const isUp = cvrDiff >= 0;
        document.getElementById('card-cvr-wow').innerHTML = `
          <span class="${isUp ? 'text-red-600' : 'text-blue-600'}">
            ${isUp ? '▲' : '▼'} ${Math.abs(cvrDiff)}%p
          </span>
          <span class="text-slate-400 font-normal">전주대비</span>
        `;
        const badge = document.getElementById('badge-cvr');
        if (parseFloat(curDerived.cvr) >= 5.0) {
          badge.textContent = '목표 달성';
          badge.className = 'px-1.5 py-0.5 text-[10px] font-bold rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200';
        } else {
          badge.textContent = '모니터링';
          badge.className = 'px-1.5 py-0.5 text-[10px] font-bold rounded-md bg-amber-50 text-amber-700 border border-amber-200';
        }
      }

      // 4. 검색 실패율
      document.getElementById('card-search-val').textContent = curDerived.searchFailRate;
      document.getElementById('card-search-extra').textContent = `${formatKoreanMan(current.searchTotal)}건`;
      if (prev) {
        const failDiff = (parseFloat(curDerived.searchFailRate) - parseFloat(prevDerived.searchFailRate)).toFixed(1);
        const isGood = failDiff <= 0; // lower is better
        document.getElementById('card-search-wow').innerHTML = `
          <span class="${isGood ? 'text-emerald-600' : 'text-red-600'}">
            ${failDiff <= 0 ? '▼' : '▲'} ${Math.abs(failDiff)}%p
          </span>
          <span class="text-slate-400 font-normal">${isGood ? '품질 개선' : '주의'}</span>
        `;
        const sBadge = document.getElementById('badge-search');
        if (isGood) {
          sBadge.textContent = '품질 개선';
          sBadge.className = 'px-1.5 py-0.5 text-[10px] font-bold rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200';
        } else {
          sBadge.textContent = '원인 분석요망';
          sBadge.className = 'px-1.5 py-0.5 text-[10px] font-bold rounded-md bg-rose-50 text-rose-700 border border-rose-200';
        }
      }

      // 5. 전체 주문금액
      const salesInEok = (current.totalSales / 100).toFixed(1);
      document.getElementById('card-rev-val').textContent = salesInEok;
      document.getElementById('card-rev-extra').textContent = `${current.basketCount}개`;
      if (prev) {
        const revPct = (((current.totalSales - prev.totalSales) / prev.totalSales) * 100).toFixed(1);
        const isUp = revPct >= 0;
        document.getElementById('card-rev-wow').innerHTML = `
          <span class="${isUp ? 'text-red-600' : 'text-blue-600'}">
            ${isUp ? '▲' : '▼'} ${Math.abs(revPct)}%
          </span>
          <span class="text-slate-400 font-normal">전주대비</span>
        `;
      }

      renderSparklines();
    }

    function renderSparklines() {
      // Build small sparklines for all dataset items up to selectedWeekIndex
      const sliceData = dataset.slice(0, selectedWeekIndex + 1);
      const labels = sliceData.map(d => d.weekName);

      const configs = [
        { id: 'sparkline-uv', data: sliceData.map(d => d.uv), color: '#3b82f6' },
        { id: 'sparkline-pv', data: sliceData.map(d => d.pv), color: '#6366f1' },
        { id: 'sparkline-cvr', data: sliceData.map(d => calcDerived(d).cvr), color: '#10b981' },
        { id: 'sparkline-search', data: sliceData.map(d => calcDerived(d).searchFailRate), color: '#f59e0b' },
        { id: 'sparkline-rev', data: sliceData.map(d => d.totalSales), color: '#ec4899' },
      ];

      configs.forEach(cfg => {
        if (sparklineInstances[cfg.id]) {
          sparklineInstances[cfg.id].destroy();
        }
        const ctx = document.getElementById(cfg.id);
        if (!ctx) return;
        
        sparklineInstances[cfg.id] = new Chart(ctx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              data: cfg.data,
              borderColor: cfg.color,
              borderWidth: 2,
              pointRadius: 2,
              pointBackgroundColor: cfg.color,
              tension: 0.35,
              fill: false
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false }, tooltip: { enabled: false } },
            scales: {
              x: { display: false },
              y: { display: false }
            }
          }
        });
      });
    }

    /* ============================================================
       4. COMPARISON MATRIX TABLE (LAST 3 WEEKS VIEW)
    ============================================================ */
    function renderComparisonTable() {
      const tbody = document.getElementById('comparisonTableBody');
      tbody.innerHTML = '';

      // Determine 3 weeks window ending at selectedWeekIndex
      const end = selectedWeekIndex;
      const start = Math.max(0, end - 2);
      const weeksWindow = dataset.slice(start, end + 1);

      // Pad headers if less than 3
      const th1 = document.getElementById('th-week-1');
      const th2 = document.getElementById('th-week-2');
      const th3 = document.getElementById('th-week-3');

      const col0 = weeksWindow[0] || null;
      const col1 = weeksWindow.length >= 2 ? weeksWindow[weeksWindow.length - 2] : null;
      const col2 = weeksWindow[weeksWindow.length - 1]; // Current selected

      th1.textContent = col0 ? `${col0.weekName}` : '-';
      th2.textContent = col1 ? `${col1.weekName}` : '-';
      th3.textContent = `${col2.weekName} (당주)`;

      // Row definitions
      const rows = [
        {
          group: '트래픽',
          name: '일평균 UV',
          extract: d => d.uv,
          fmt: v => formatNumber(v),
          type: 'pct'
        },
        {
          group: '트래픽',
          name: '일평균 PV',
          extract: d => d.pv,
          fmt: v => formatNumber(v),
          type: 'pct'
        },
        {
          group: '트래픽',
          name: 'UV 당 PV',
          extract: d => parseFloat(calcDerived(d).uvPerPv),
          fmt: v => `${formatDecimal(v, 1)}건`,
          type: 'diff'
        },
        {
          group: '구매전환',
          name: '주문건수',
          extract: d => d.orderCount,
          fmt: v => `${formatNumber(v)}건`,
          type: 'pct'
        },
        {
          group: '구매전환',
          name: '구매전환율 (%)',
          extract: d => parseFloat(calcDerived(d).cvr),
          fmt: v => `${formatDecimal(v, 1)}%`,
          type: 'diff_p'
        },
        {
          group: '검색',
          name: '전체 검색수',
          extract: d => d.searchTotal,
          fmt: v => formatNumber(v),
          type: 'pct'
        },
        {
          group: '검색',
          name: '검색 실패수',
          extract: d => d.searchFail,
          fmt: v => formatNumber(v),
          type: 'pct'
        },
        {
          group: '검색',
          name: '검색실패율 (%)',
          extract: d => parseFloat(calcDerived(d).searchFailRate),
          fmt: v => `${formatDecimal(v, 1)}%`,
          type: 'diff_p_reverse' // lower is green
        },
        {
          group: '검색',
          name: '검색구매비중 (%)',
          extract: d => parseFloat(calcDerived(d).searchRevenueShare),
          fmt: v => `${formatDecimal(v, 1)}%`,
          type: 'diff_p'
        },
        {
          group: '매출/바스켓',
          name: '전체주문금액(백만)',
          extract: d => d.totalSales,
          fmt: v => `${formatNumber(v)}백만`,
          type: 'pct'
        },
        {
          group: '매출/바스켓',
          name: '건당수량 (바스켓)',
          extract: d => parseFloat(d.basketCount),
          fmt: v => `${formatDecimal(v, 1)}개`,
          type: 'diff'
        }
      ];

      // Track group rowspan
      let lastGroup = '';

      rows.forEach((r, idx) => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 transition-colors";

        const val0 = col0 ? r.extract(col0) : null;
        const val1 = col1 ? r.extract(col1) : null;
        const val2 = r.extract(col2);

        // WoW difference
        let wowHtml = '-';
        if (col1 && val1 !== null && val1 !== 0) {
          if (r.type === 'pct') {
            const diffPct = (((val2 - val1) / val1) * 100).toFixed(1);
            const isUp = diffPct >= 0;
            wowHtml = `<span class="font-bold ${isUp ? 'text-red-600' : 'text-blue-600'}">${isUp ? '▲' : '▼'} ${Math.abs(diffPct)}%</span>`;
          } else if (r.type === 'diff_p' || r.type === 'diff_p_reverse') {
            const diffP = (val2 - val1).toFixed(1);
            const isUp = diffP >= 0;
            let color = isUp ? 'text-red-600' : 'text-blue-600';
            if (r.type === 'diff_p_reverse') {
              color = isUp ? 'text-red-600' : 'text-emerald-600';
            }
            wowHtml = `<span class="font-bold ${color}">${isUp ? '▲' : '▼'} ${Math.abs(diffP)}%p</span>`;
          } else {
            const diff = (val2 - val1).toFixed(1);
            const isUp = diff >= 0;
            wowHtml = `<span class="font-bold ${isUp ? 'text-red-600' : 'text-blue-600'}">${isUp ? '▲' : '▼'} ${Math.abs(diff)}</span>`;
          }
        }

        // Mini sparkline SVG
        const sparkSvg = createInlineSvgSpark([val0, val1, val2]);

        tr.innerHTML = `
          <td class="py-3 px-4 font-semibold text-slate-500 bg-slate-50/50">${r.group}</td>
          <td class="py-3 px-4 font-medium text-slate-900">${r.name}</td>
          <td class="py-3 px-4 text-right text-slate-600 font-mono">${val0 !== null ? r.fmt(val0) : '-'}</td>
          <td class="py-3 px-4 text-right text-slate-600 font-mono">${val1 !== null ? r.fmt(val1) : '-'}</td>
          <td class="py-3 px-4 text-right font-bold font-mono text-slate-900 bg-blue-50/40">${r.fmt(val2)}</td>
          <td class="py-3 px-4 text-right">${wowHtml}</td>
          <td class="py-3 px-4 text-center">${sparkSvg}</td>
        `;

        tbody.appendChild(tr);
      });
    }

    function createInlineSvgSpark(values) {
      const valid = values.filter(v => v !== null && !isNaN(v));
      if (valid.length < 2) return '<span class="text-slate-300">-</span>';
      
      const min = Math.min(...valid);
      const max = Math.max(...valid);
      const range = max - min || 1;
      const width = 60;
      const height = 18;

      const points = valid.map((v, i) => {
        const x = (i / (valid.length - 1)) * (width - 8) + 4;
        const y = height - ((v - min) / range) * (height - 6) - 3;
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      }).join(' ');

      return `
        <svg width="${width}" height="${height}" class="inline-block overflow-visible">
          <polyline fill="none" stroke="#3b82f6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" points="${points}" />
          <circle cx="${points.split(' ').pop().split(',')[0]}" cy="${points.split(' ').pop().split(',')[1]}" r="2.5" fill="#1d4ed8" />
        </svg>
      `;
    }

