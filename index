    /* ============================================================
       7. TAB & MODAL CONTROLS
    ============================================================ */
    function switchTab(tabId) {
      ['summary', 'trends', 'table'].forEach(t => {
        const content = document.getElementById(`content-${t}`);
        const btn = document.getElementById(`tab-${t}`);
        if (t === tabId) {
          content.classList.remove('hidden');
          btn.className = 'tab-btn py-3 border-b-2 border-brand-600 text-brand-600 flex items-center space-x-1.5 font-bold';
        } else {
          content.classList.add('hidden');
          btn.className = 'tab-btn py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-1.5 font-medium';
        }
      });

      if (tabId === 'trends') {
        setTimeout(renderTrendCharts, 50);
      }
    }

    function openDataModal(index = -1) {
      const modal = document.getElementById('dataModal');
      const form = document.getElementById('metricForm');
      form.reset();

      if (index >= 0) {
        document.getElementById('modalTitle').textContent = `[${dataset[index].weekName}] 데이터 수정`;
        document.getElementById('editIndex').value = index;
        const d = dataset[index];
        document.getElementById('inputWeekName').value = d.weekName;
        document.getElementById('inputDateRange').value = d.dateRange;
        document.getElementById('inputUV').value = d.uv;
        document.getElementById('inputPV').value = d.pv;
        document.getElementById('inputOrderCount').value = d.orderCount;
        document.getElementById('inputSearchTotal').value = d.searchTotal;
        document.getElementById('inputSearchFail').value = d.searchFail;
        document.getElementById('inputSearchOrders').value = d.searchOrders;
        document.getElementById('inputTotalSales').value = d.totalSales;
        document.getElementById('inputSearchSales').value = d.searchSales || '';
        document.getElementById('inputBasketCount').value = d.basketCount;
      } else {
        document.getElementById('modalTitle').textContent = '새 주차 지표 데이터 추가';
        document.getElementById('editIndex').value = -1;
      }

      modal.classList.remove('hidden');
    }

    function closeDataModal() {
      document.getElementById('dataModal').classList.add('hidden');
    }

    function handleFormSubmit(e) {
      e.preventDefault();
      const editIdx = parseInt(document.getElementById('editIndex').value, 10);

      const newItem = {
        weekName: document.getElementById('inputWeekName').value.trim(),
        dateRange: document.getElementById('inputDateRange').value.trim(),
        uv: parseFloat(document.getElementById('inputUV').value),
        pv: parseFloat(document.getElementById('inputPV').value),
        orderCount: parseFloat(document.getElementById('inputOrderCount').value),
        searchTotal: parseFloat(document.getElementById('inputSearchTotal').value),
        searchFail: parseFloat(document.getElementById('inputSearchFail').value),
        searchOrders: parseFloat(document.getElementById('inputSearchOrders').value),
        totalSales: parseFloat(document.getElementById('inputTotalSales').value),
        searchSales: parseFloat(document.getElementById('inputSearchSales').value) || (parseFloat(document.getElementById('inputTotalSales').value) * 0.3),
        basketCount: parseFloat(document.getElementById('inputBasketCount').value)
      };

      if (editIdx >= 0) {
        dataset[editIdx] = newItem;
        showToast('데이터가 성공적으로 수정되었습니다.');
      } else {
        dataset.push(newItem);
        selectedWeekIndex = dataset.length - 1;
        showToast('새 주차 데이터가 추가되었습니다.');
      }

      saveData();
      closeDataModal();
      renderAll();
    }

    function editWeek(idx) {
      openDataModal(idx);
    }

    function deleteWeek(idx) {
      if (dataset.length <= 1) {
        alert('최소 1개 이상의 주차 데이터가 존재해야 합니다.');
        return;
      }
      if (confirm(`'${dataset[idx].weekName}' 데이터를 정말 삭제하시겠습니까?`)) {
        dataset.splice(idx, 1);
        if (selectedWeekIndex >= dataset.length) {
          selectedWeekIndex = dataset.length - 1;
        }
        saveData();
        renderAll();
        showToast('데이터가 삭제되었습니다.');
      }
    }

    /* ============================================================
       8. UTILITIES (COPY SCRIPT, EXPORT CSV, TOAST)
    ============================================================ */
    function copyScript() {
      const scriptEl = document.getElementById('verbalScriptText');
      const textToCopy = scriptEl.innerText || scriptEl.textContent;

      const textarea = document.createElement('textarea');
      textarea.value = textToCopy;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      
      try {
        document.execCommand('copy');
        const btnText = document.getElementById('copyBtnText');
        btnText.textContent = '복사 완료!';
        showToast('구두 발표 스크립트가 클립보드에 복사되었습니다.');
        setTimeout(() => {
          btnText.textContent = '구두보고 복사';
        }, 2000);
      } catch (err) {
        showToast('복사에 실패했습니다. 직접 복사해주세요.');
      }
      document.body.removeChild(textarea);
    }

    function exportToCSV() {
      let csv = "\uFEFF주차,기간,일평균UV,일평균PV,UV당PV,주문건수,구매전환율(%),검색수,검색실패수,검색실패율(%),주문금액(백만),건당수량\n";
      dataset.forEach(d => {
        const dr = calcDerived(d);
        csv += `"${d.weekName}","${d.dateRange}",${d.uv},${d.pv},${dr.uvPerPv},${d.orderCount},${dr.cvr},${d.searchTotal},${d.searchFail},${dr.searchFailRate},${d.totalSales},${d.basketCount}\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement("a");
      const url = URL.createObjectURL(blob);
      link.setAttribute("href", url);
      link.setAttribute("download", `제타_주요지표_주간리뷰_${new Date().toISOString().slice(0,10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('CSV 파일이 다운로드되었습니다.');
    }

    function showToast(msg) {
      const toast = document.getElementById('toastMessage');
      const text = document.getElementById('toastText');
      text.textContent = msg;
      toast.classList.remove('opacity-0', 'translate-y-2');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-2');
      }, 2500);
    }

    /* ============================================================
       9. MASTER RENDER CONTROLLER
    ============================================================ */
    function renderAll() {
      if (!dataset.length) return;
      
      const current = dataset[selectedWeekIndex];
      const prev = selectedWeekIndex > 0 ? dataset[selectedWeekIndex - 1] : null;

      renderWeekSelector();
      renderExecutiveBriefing(current, prev);
      renderKpiCards(current, prev);
      renderComparisonTable();
      renderAllDataTable();
    }

    window.onload = function() {
      initData();
      renderAll();
    };
  </script>
